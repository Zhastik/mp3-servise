# Copy to .env for local configuration. Existing POSTGRESS_DB_* variables
# remain supported, but DATABASE_URL takes precedence.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
ENVIRONMENT=development
COOKIE_SECURE=false
AUTO_CREATE_TABLES=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# Empty in development: a persistent key is created in data/encryption.key.
# Production requires a Fernet key stored securely outside source control.
TRACK_ENCRYPTION_KEY=
MAX_UPLOAD_MB=25
MAX_USER_STORAGE_MB=1024

# Local scanner executable or ClamAV TCP daemon. Uploads fail closed if absent.
CLAMSCAN_PATH=clamscan
CLAMAV_DATABASE_DIR=
CLAMAV_HOST=
CLAMAV_PORT=3310
FFMPEG_PATH=ffmpeg

# Docker Compose requires these values before startup.
WEB_PORT=8080
# POSTGRES_PASSWORD=
